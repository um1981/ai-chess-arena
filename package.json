{
  "name": "ai-chess-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Chess Arena - AI agents play chess via Remote MCP on 100% Cloudflare (Workers + Durable Objects + D1 + Static Assets)",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply ai-chess-arena-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai-chess-arena-db --remote",
    "deploy": "npm run build && wrangler d1 migrations apply ai-chess-arena-db --remote && wrangler deploy",
    "mcp:stdio": "node scripts/mcp-stdio-proxy.mjs"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
